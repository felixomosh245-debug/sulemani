# Copy this file to .env and fill in the values. Never commit .env.

# Claude
ANTHROPIC_API_KEY=
# Model for everyday questions (fast and low cost)
CHAT_MODEL=claude-haiku-4-5-20251001
# Model for setting and marking quizzes (more careful)
GRADING_MODEL=claude-sonnet-5-5

# WhatsApp Cloud API (from your Meta app dashboard)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret phrase you choose; enter the same phrase in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App settings > Basic). Used to confirm messages really come from Meta.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# Google service account key, pasted as one line of JSON. Only needed for clients using "drive" storage.
GOOGLE_SERVICE_ACCOUNT_JSON=

# General
PORT=3000
DEFAULT_COUNTRY_CODE=254
CLIENTS_FILE=config/clients.json
# How long to keep knowledge bases and learner lists in memory before re-reading (minutes)
CACHE_MINUTES=5
# Maximum characters of knowledge base sent to Claude per client
KB_MAX_CHARS=150000
